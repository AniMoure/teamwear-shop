<div class="mx-auto max-w-3xl">
  <h1 class="mb-8 text-center text-2xl font-bold">Checkout</h1>

  <%= render "summary",
        lines: @cart.cart_items.includes(:product).order(:id).map { |item| [ item.product.name, item.quantity, item.total_cents ] },
        total_cents: @cart.total_cents %>

  <%= form_with model: @order, class: "mt-8 space-y-4 rounded-xl border border-gray-200 bg-white p-6" do |form| %>
    <% if @order.errors.any? %>
      <ul class="rounded-lg bg-red-50 p-4 text-sm text-red-700">
        <% @order.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    <% end %>

    <div>
      <%= form.label :customer_name, "Name", class: "block text-sm font-medium text-gray-700" %>
      <%= form.text_field :customer_name, required: true, autocomplete: "name",
            class: "mt-1 w-full rounded-lg border border-gray-300 px-3 py-2" %>
    </div>

    <div>
      <%= form.label :email, class: "block text-sm font-medium text-gray-700" %>
      <%= form.email_field :email, required: true, autocomplete: "email",
            class: "mt-1 w-full rounded-lg border border-gray-300 px-3 py-2" %>
    </div>

    <div class="flex items-center justify-between">
      <%= link_to "Back to the cart", cart_path, class: "font-medium text-gray-900 underline" %>
      <%= form.submit "Place order", data: { turbo_submits_with: "Placing order…" },
            class: "cursor-pointer rounded-lg bg-gray-900 px-5 py-2 font-medium text-white hover:bg-gray-700" %>
    </div>
  <% end %>
</div>
