<%# lines: [[name, quantity, total_cents], ...] %>
<div class="overflow-hidden rounded-xl border border-gray-200 bg-white">
  <% lines.each do |name, quantity, total_cents| %>
    <div class="flex items-center justify-between gap-4 border-b border-gray-100 p-4 last:border-b-0">
      <p class="text-gray-900"><%= name %> <span class="text-gray-500">× <%= quantity %></span></p>
      <p class="font-semibold text-gray-900"><%= format_price(total_cents) %></p>
    </div>
  <% end %>
</div>
<p class="mt-4 text-right text-xl font-bold text-gray-900">Total: <%= format_price(total_cents) %></p>
