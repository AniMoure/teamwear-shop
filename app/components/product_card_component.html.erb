<div class="flex flex-col justify-between rounded-xl border border-gray-200 bg-white p-5 shadow-sm transition hover:shadow-md">
  <h3 class="text-lg font-semibold text-gray-900"><%= @product.name %></h3>
  <div class="mt-6 flex items-center justify-between">
    <p class="text-xl font-bold text-gray-900"><%= formatted_price %></p>
    <%= button_to "Add to cart", helpers.cart_items_path(product_id: @product.id),
          class: "rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-700 cursor-pointer" %>
  </div>
</div>
